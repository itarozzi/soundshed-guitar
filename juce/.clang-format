# Our C++ under juce/ (source/, tests/, benchmarks/) follows the repo-root style, as core/ and
# nanoq/ do. Vendored trees keep their own: modules/clap-juce-extensions and ASIOSDK/vstgui4 each
# carry a .clang-format, and JUCE/ is a submodule we never format.
---
Language: Cpp
BasedOnStyle: InheritParentConfig
---
Language: ObjC
BasedOnStyle: Chromium
BreakBeforeBraces: Allman
ColumnLimit: 0
IndentWidth: 4
KeepEmptyLinesAtTheStartOfBlocks: false
ObjCSpaceAfterProperty: true
ObjCSpaceBeforeProtocolList: true
PointerAlignment: Left
SpacesBeforeTrailingComments: 1
TabWidth: 4
UseTab: Never