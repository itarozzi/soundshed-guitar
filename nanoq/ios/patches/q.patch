@@ -24,8 +24,16 @@ set(q_plug_VERSION "${q_plug_VERSION}" CACHE INTERNAL "")
 # everywhere. Examples pass this to make_clapfirst_plugins, and ask it for
 # a standalone app as well, which hosts the CLAP with its own audio and
 # MIDI devices through RtAudio and RtMidi, fetched at configure time.
-set(formats CLAP VST3)
-if(APPLE)
+# iOS takes none of them: a plugin there is linked into the app that hosts
+# it, which is the plugin's own business, and clap-wrapper is not added.
+if(CMAKE_SYSTEM_NAME STREQUAL "iOS")
+   set(Q_PLUG_IOS ON)
+   set(formats)
+else()
+   set(Q_PLUG_IOS OFF)
+   set(formats CLAP VST3)
+endif()
+if(APPLE AND NOT Q_PLUG_IOS)
    list(APPEND formats AUV2)
 endif()
 set(Q_PLUG_PLUGIN_FORMATS "${formats}" CACHE INTERNAL "")
@@ -68,6 +76,12 @@ FetchContent_Declare(
    GIT_SHALLOW ON
 )
 set(JSON_BuildTests OFF CACHE INTERNAL "")
+if(Q_PLUG_IOS)
+   # The CLAP headers without clap-wrapper, which would otherwise add them.
+   FetchContent_MakeAvailable(clap cycfi_elements nlohmann_json)
+   add_library(clap INTERFACE)
+   target_include_directories(clap INTERFACE "${clap_SOURCE_DIR}/include")
+else()
 FetchContent_MakeAvailable(clap clap_wrapper cycfi_elements
    nlohmann_json)
 
@@ -81,6 +95,7 @@ set(CLAP_SDK_ROOT "${clap_SOURCE_DIR}" CACHE PATH "" FORCE)
 
 add_subdirectory(${clap_wrapper_SOURCE_DIR} ${clap_wrapper_BINARY_DIR}
    EXCLUDE_FROM_ALL)
+endif()
 
