diff --git a/lib/src/element/port.cpp b/lib/src/element/port.cpp
index a41dee9f..143c87e9 100644
--- a/lib/src/element/port.cpp
+++ b/lib/src/element/port.cpp
@@ -457,8 +457,15 @@ namespace cycfi::elements
             if (reposition(ctx, btn.pos))
                return true;
          }
+         // Only the end of a scroll bar drag changes how the scroller looks.
+         // A press or release on its content redrew all of it, which on a CPU
+         // backend (Quartz on iOS) cost a draw of the whole scrolled area per
+         // tap.
+         else if (_tracking != none)
+         {
+            refresh(ctx);
+         }
          _tracking = none;
-         refresh(ctx);
       }
       return port_element::click(ctx, btn);
    }
diff --git a/lib/src/view.cpp b/lib/src/view.cpp
index 4e45b0d6..5bd53bee 100644
--- a/lib/src/view.cpp
+++ b/lib/src/view.cpp
@@ -335,15 +335,51 @@ namespace cycfi::elements
          _click_focus = current_focus_path();
 
       bool handled = false;
+
+      // The innermost focused element, to tell whether a click moved the
+      // focus.
+      auto const focus_leaf = [this]
+      {
+         element const* leaf = nullptr;
+         element const* e = _content.focus();
+         for (int depth = 0; e && e != leaf && depth < 64; ++depth)
+         {
+            leaf = e;
+            e = e->focus();
+         }
+         return leaf;
+      };
+      auto const is_text_box = [](element const* e)
+      {
+         return dynamic_cast<basic_text_box const*>(e) != nullptr;
+      };
+      auto const focused = focus_leaf();
+      // Asked now: the click may remove the element (a dialog it closes).
+      bool const focused_text_box = is_text_box(focused);
+
       with_context_do(
-         [btn, this, &handled](auto const& ctx, auto& _main_element)
+         [btn, this, &handled, focused, focused_text_box, &focus_leaf, &is_text_box](auto const& ctx, auto& _main_element)
          {
             handled = _main_element.click(ctx, btn);
             if (handled)
                _is_focus = _main_element.focus();
             else if (btn.down)
                elements::relinquish_focus(_content, ctx);
-            refresh(_main_element);
+
+            // An element redraws what a click changed in it; the view is not
+            // redrawn whole on every press and release, which on a CPU
+            // backend (Quartz on iOS) cost two whole-window draws per tap.
+            // What focus shows is a text box's caret, so a text box that
+            // gains or loses the focus is redrawn (by address: the one that
+            // lost it may be gone, and is then simply not found).
+            auto const now = focus_leaf();
+            if (now != focused)
+            {
+               if (focused_text_box)
+                  refresh(const_cast<element&>(*focused));
+               if (is_text_box(now))
+                  refresh(const_cast<element&>(*now));
+            }
          },
          *this, _current_bounds
       );
