diff --git a/lib/src/support/log.cpp b/lib/src/support/log.cpp
index 2ff25f97..4d70c70c 100644
--- a/lib/src/support/log.cpp
+++ b/lib/src/support/log.cpp
@@ -164,10 +164,16 @@ namespace cycfi::elements
       // Sandboxed host (Logic Pro, the AU hosting service) denies, and it
       // refuses a second backend in one process (two plugins each with
       // their own copy of quill). Skip the check.
+      //
+      // quill's default idle sleep is 500 ns. Where the OS honours a wait
+      // that short (macOS does) the backend thread wakes ~100,000 times a
+      // second and takes most of a core while there is nothing to log.
+      // 10 ms holds a line back at most that long before it reaches the file.
       quill::BackendOptions backend_options()
       {
          quill::BackendOptions options;
          options.check_backend_singleton_instance = false;
+         options.sleep_duration = std::chrono::milliseconds{10};
          return options;
       }
 
